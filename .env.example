# Adobe Commerce Cloud Service (ACCS) Configuration
# Copy this file to .env and fill in your actual values

# ACCS GraphQL Endpoint
# Get this from your ACCS instance dashboard
# Format: https://{region}-sandbox.api.commerce.adobe.com/{environment-id}/graphql
ACCS_GRAPHQL_ENDPOINT=https://na1-sandbox.api.commerce.adobe.com/your-env-id/graphql

# Store Configuration
# These should match your ACCS store setup
ACCS_WEBSITE_CODE=base
ACCS_STORE_CODE=main_website_store
ACCS_STORE_VIEW_CODE=default
